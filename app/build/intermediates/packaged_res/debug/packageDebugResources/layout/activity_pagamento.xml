<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootPagamentoLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5"
    android:fitsSystemWindows="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1565C0"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="📍 Entrega e Pagamento"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:elevation="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- SEÇÃO DE ENTREGA (REAL) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚚 Endereço de Entrega (Obrigatório)"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#1565C0" />

            <!-- CEP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/edtCep"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="CEP (Ex: 01001000)"
                    android:inputType="number"
                    android:maxLength="8"
                    android:background="@drawable/bg_search"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnBuscarCep"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:text="🔍 Buscar CEP"
                    android:textSize="12sp"
                    android:backgroundTint="#1565C0" />
            </LinearLayout>

            <!-- Rua / Logradouro -->
            <EditText
                android:id="@+id/edtRua"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:hint="Rua / Avenida"
                android:background="@drawable/bg_search"
                android:paddingHorizontal="12dp"
                android:textSize="14sp" />

            <!-- Número e Bairro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/edtNumero"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:hint="Número"
                    android:inputType="number"
                    android:background="@drawable/bg_search"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/edtBairro"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:hint="Bairro"
                    android:background="@drawable/bg_search"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Cidade e Estado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/edtCidade"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="Cidade"
                    android:background="@drawable/bg_search"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/edtEstado"
                    android:layout_width="80dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:hint="UF"
                    android:maxLength="2"
                    android:background="@drawable/bg_search"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#CCCCCC" />

            <!-- RESUMO E PAGAMENTO (SIMULADO) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💳 Formas de Pagamento (Simulado)"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#424242" />

            <RadioGroup
                android:id="@+id/rgFormaPagamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search"
                android:padding="8dp">

                <RadioButton
                    android:id="@+id/rbPix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=" Pix"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbCartao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=" Cartão de Crédito" />

                <RadioButton
                    android:id="@+id/rbDinheiro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=" Dinheiro na Entrega" />
            </RadioGroup>

            <TextView
                android:id="@+id/txtTotalPagamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Total: R$ 0,00"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#2E7D32" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnConfirmarPagamento"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="12dp"
        android:text="🔒 Confirmar Pedido e Pagamento"
        android:textSize="16sp"
        android:backgroundTint="#2E7D32" />
</LinearLayout>