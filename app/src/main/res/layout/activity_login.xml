<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#F4F6F9"
    android:fitsSystemWindows="true">

    <!-- Logo / Título -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Compraê Jovem"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#1976D2"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="A sua loja virtual escolar"
        android:textSize="15sp"
        android:textColor="#78909C"
        android:layout_marginBottom="40dp" />

    <!-- Campo de E-mail -->
    <EditText
        android:id="@+id/edtEmailLogin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="✉️  Digite seu E-mail"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_input_modern"
        android:layout_marginBottom="16dp"
        android:elevation="2dp" />

    <!-- Campo de Senha -->
    <EditText
        android:id="@+id/edtSenhaLogin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="🔒  Sua Senha"
        android:inputType="textPassword"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_input_modern"
        android:layout_marginBottom="32dp"
        android:elevation="2dp" />

    <!-- ÚNICO BOTÃO DE ENTRAR -->
    <Button
        android:id="@+id/btnEntrar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Entrar"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1976D2"
        app:cornerRadius="12dp" />

    <!-- Botão Cadastre-se -->
    <TextView
        android:id="@+id/btnIrParaCadastro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Ainda não tem conta? Cadastre-se"
        android:textColor="#1976D2"
        android:textSize="15sp"
        android:textStyle="bold"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>