<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5"
    android:fitsSystemWindows="true">
    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1565C0"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="🛒  Seu Carrinho"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:elevation="4dp" />

    <!-- Mensagem de carrinho vazio -->
    <TextView
        android:id="@+id/txtCarrinhoVazio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Seu carrinho está vazio\n\nAdicione produtos na loja 😊"
        android:textSize="16sp"
        android:textColor="#9E9E9E"
        android:lineSpacingExtra="4dp"
        android:visibility="visible" />

    <!-- Lista de itens -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCarrinho"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <!-- Rodapé do total -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <TextView
            android:id="@+id/txtTotalCarrinho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: R$ 0,00"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2E7D32" />

        <Button
            android:id="@+id/btnFinalizarCompra"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Finalizar Compra"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#2E7D32" />
    </LinearLayout>
</LinearLayout>