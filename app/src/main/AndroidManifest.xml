<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Compraê Jovem"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <activity
            android:name="com.example.compraejovem.ui.home.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.compraejovem.ui.auth.LoginActivity"
            android:exported="false" />

        <activity
            android:name="com.example.compraejovem.ui.auth.CadastroActivity"
            android:exported="false" />

        <activity
            android:name="com.example.compraejovem.ui.product.CadastroProdutoActivity"
            android:exported="false" />

        <activity
            android:name="com.example.compraejovem.ui.product.DetalheProdutoActivity"
            android:exported="false" />

        <activity
            android:name="com.example.compraejovem.ui.cart.CarrinhoActivity"
            android:exported="false" />

        <activity
            android:name="com.example.compraejovem.ui.cart.PagamentoActivity"
            android:exported="false" />

        <activity
            android:name="com.example.compraejovem.ui.cart.MeusPedidosActivity"
            android:exported="false" />

    </application>

</manifest>